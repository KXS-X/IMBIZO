# Configuration du Serveur Backend
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Base de Données PostgreSQL
# Pour le développement local direct :
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devops_tracker?schema=public"
# Pour Docker Compose :
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/devops_tracker?schema=public"

# Sécurité & JSON Web Token (JWT)
JWT_SECRET="devops_tracker_super_secret_jwt_key_2026_change_in_prod"
JWT_EXPIRES_IN="7d"
